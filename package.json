{
  "name": "lolping-video",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/web/server.ts",
    "build": "bun run typecheck && rm -rf dist && bun run build.ts",
    "typecheck": "bun check",
    "render": "remotion render src/index.ts PingDemo out/ping-demo.webm",
    "render:prores": "remotion render src/index.ts PingDemo out/ping-demo.mov --codec=prores --prores-profile=4444 --pixel-format=yuva444p10le --image-format=png",
    "predeploy": "bun run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@remotion/cli": "^4.0.545",
    "@remotion/media": "4.0.545",
    "@remotion/player": "^4.0.545",
    "@remotion/web-renderer": "^4.0.545",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^27.2.3",
    "konva": "^10.10.0",
    "lucide-react": "^1.77.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "remotion": "^4.0.545",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "gh-pages": "^6.3.0",
    "typescript": "^7.0.2"
  }
}
